# APIの公開HTTPS URL。末尾の/は不要。必須。
EXPO_PUBLIC_API_BASE_URL=https://your-studio-book-api.example.com

# 公開Webのドメイン。APIのimageNameが手元assetsにない時の画像取得に利用（任意）
EXPO_PUBLIC_WEB_BASE_URL=https://your-studio-book-web.example.com

# 実際のキャンセルAPI仕様を確認してから設定してください（未設定時は操作不可）
# 例（仮のパス、実装済みという意味ではない）
# EXPO_PUBLIC_CANCEL_API_PATH=/api/reservations/{id}/cancel
# EXPO_PUBLIC_CANCEL_API_METHOD=POST

# Stripe Checkoutの独自ドメインを利用する場合に設定。通常は不要。
# EXPO_PUBLIC_CHECKOUT_ALLOWED_HOSTS=pay.example.com
